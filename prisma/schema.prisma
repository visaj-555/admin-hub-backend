generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────── Enums ───────────────

enum UserRole {
  ADMIN
  USER
  EDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingDuration {
  ONE_HOUR           @map("1hr")
  ONE_AND_HALF_HOURS @map("1.5hr")
  TWO_HOURS          @map("2hr")
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertType {
  TRANSACTION_FAILED
  BOOKING_PENDING
  BOOKING_CANCELLED
  USER_SUSPENDED
  SYSTEM
}

// ─────────────── Models ───────────────

model User {
  id String @id @default(uuid(7)) @db.Uuid

  firstName    String  @map("first_name") @db.VarChar(80)
  lastName     String? @map("last_name") @db.VarChar(80)
  phone        String? @unique @db.VarChar(30)
  profileImage String? @map("profile_image") @db.VarChar(500)

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auth         Auth?
  bookings     Booking[]
  transactions Transaction[]
  alerts       Alert[]

  @@index([status, createdAt])
  @@index([role])
  @@map("users")
}

model Auth {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  email        String @unique @db.VarChar(255) // store lowercased
  passwordHash String @map("password_hash")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth")
}

model Booking {
  id String @id @default(uuid(7)) @db.Uuid

  bookingNumber String          @unique @map("booking_number") @db.VarChar(40)
  userId        String          @map("user_id") @db.Uuid
  service       String          @db.VarChar(120)
  amount        Decimal         @db.Decimal(14, 2)
  duration      BookingDuration

  scheduledAt DateTime      @map("scheduled_at") @db.Timestamptz(3)
  status      BookingStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  alerts       Alert[]

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("bookings")
}

model Transaction {
  id String @id @default(uuid(7)) @db.Uuid

  transactionNumber String @unique @map("transaction_number") @db.VarChar(40)

  userId    String  @map("user_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid

  type   TransactionType
  status TransactionStatus @default(PENDING)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("INR") @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  alerts  Alert[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([bookingId])
  @@index([createdAt])
  @@map("transactions")
}

model Alert {
  id String @id @default(uuid(7)) @db.Uuid

  type     AlertType
  severity AlertSeverity @default(INFO)
  title    String        @db.VarChar(160)
  message  String?       @db.Text

  isRead     Boolean   @default(false) @map("is_read")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  // optional links to the record the alert is about
  userId        String? @map("user_id") @db.Uuid
  bookingId     String? @map("booking_id") @db.Uuid
  transactionId String? @map("transaction_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([isRead, createdAt])
  @@index([severity, createdAt])
  @@index([userId])
  @@index([bookingId])
  @@index([transactionId])
  @@map("alerts")
}
